# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/grounders

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-secret-key-min-32-chars
# Lifetime of the access token, as an ms duration string.
ACCESS_TOKEN_EXPIRY=30d
# Lifetime of the refresh token, in whole days.
REFRESH_TOKEN_EXPIRY_DAYS=365

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
# Forces the dev path even when Twilio credentials are present: no SMS is sent
# and the code comes back in the /auth/request-otp response. Never true in
# production — that response hands the sign-in code to whoever asks for it.
DEV_MODE=true

# Twilio (SMS OTP). All three must be set, and DEV_MODE must not be true, or
# SMS stays disabled and phone codes fall back to the response body.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend — sends email OTPs and moderation alerts.
# RESEND_API_KEY with RESEND_FROM_EMAIL enables email sign-in codes; without
# both, email codes fall back to the response body the same way SMS does.
# MODERATION_EMAIL is where report alerts go; without it reports still land in
# the database and only the alert is skipped.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Grounders <login@grounders.app>
MODERATION_EMAIL=

# App Store / Play Console reviewers cannot receive SMS. With both set, this
# phone skips the OTP table entirely and signs straight in as the pre-seeded
# reviewer user. With either unset the branch is dead code — leave them blank
# outside of a review window.
APP_REVIEW_PHONE=
APP_REVIEW_OTP=

# ── Invites ───────────────────────────────────────────────────────────────────
# Download links in invite SMS. Both fall back to the production hosts.
GROUNDERS_APP_URL=https://grounders.app
RADIO_APP_URL=https://itsradio.app
# ── Media storage (Cloudflare R2) ─────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=grounders-media
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ── Firebase Cloud Messaging ──────────────────────────────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate new private key.
# Open the downloaded JSON and copy the three values below.
# Keep the literal \n sequences in FIREBASE_PRIVATE_KEY — the server replaces them.
# If any are blank, push is disabled and the rest of the API still works.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=*

# ── Google multi-account MCP connector ────────────────────────────────────────
# Public HTTPS origin this API is reachable at. Used for OAuth redirect URIs and
# for the discovery documents Claude reads — must match the deployed URL exactly,
# no trailing slash.
PUBLIC_BASE_URL=https://api.yourdomain.com

# Google Cloud → APIs & Services → Credentials → OAuth client (Web application).
# Authorized redirect URI must be exactly: <PUBLIC_BASE_URL>/gmail/oauth/callback
# Enable the Gmail, Calendar, Drive, People and Tasks APIs on the same project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Operator password. Gates both the consent screen Claude sends you to and the
# account-linking pages. Without it the connector refuses to authorize at all.
MCP_ADMIN_PASSWORD=

# Drive sharing. Off by default, matching Claude's first-party Drive connector,
# which can only share with a named person: with this unset, share_file takes an
# email address and a role, and cannot publish a file to a whole domain or to
# anyone with the link. Set to true only if you want those back.
DRIVE_ALLOW_PUBLIC_SHARING=false

# 32 bytes, base64 or hex — encrypts Google tokens at rest (AES-256-GCM).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this invalidates every stored token; all accounts must be re-linked.
TOKEN_ENC_KEY=
