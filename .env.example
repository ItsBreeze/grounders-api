# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/grounders

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-secret-key-min-32-chars
JWT_EXPIRES_IN=30d

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
DEV_MODE=true

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend (moderation alert emails)
RESEND_API_KEY=
MODERATION_EMAIL=

# ── Media storage (Cloudflare R2) ─────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=grounders-media
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ── Firebase Cloud Messaging ──────────────────────────────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate new private key.
# Open the downloaded JSON and copy the three values below.
# Keep the literal \n sequences in FIREBASE_PRIVATE_KEY — the server replaces them.
# If any are blank, push is disabled and the rest of the API still works.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── MCP connector (Claude / ChatGPT / Gemini) ─────────────────────────────────
# The public https origin this API answers on, no path, no trailing slash.
# The OAuth discovery documents advertise it verbatim, so if it is wrong the
# connector fails inside the assistant in a way that looks like their bug.
# Optional: falls back to the request's own host, which is right on Railway.
PUBLIC_BASE_URL=https://grounders-api-production.up.railway.app

# Offhand's built-in Grounders + Radio. Offhand's server presents this key to
# link a user by a phone number it has verified, and receives the same
# connector tokens the consent page issues. 32+ chars, the same value as
# GROUNDERS_PARTNER_KEY on the Offhand server: openssl rand -base64 48
# Unset, the partner endpoints answer 503 and nothing else changes.
OFFHAND_PARTNER_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=*
