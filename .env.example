# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/grounders

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-secret-key-min-32-chars
JWT_EXPIRES_IN=30d

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
DEV_MODE=true

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend (moderation alert emails)
RESEND_API_KEY=
MODERATION_EMAIL=

# ── Media storage (Cloudflare R2) ─────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=grounders-media
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ── Firebase Cloud Messaging ──────────────────────────────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate new private key.
# Open the downloaded JSON and copy the three values below.
# Keep the literal \n sequences in FIREBASE_PRIVATE_KEY — the server replaces them.
# If any are blank, push is disabled and the rest of the API still works.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Voice-note transcription (Radio) ──────────────────────────────────────────
# A Radio voice note transcribes itself when it is recorded, and the text shows
# under the tile in ItsRadio and reaches the MCP connector. Deepgram is the
# only provider wired up (nova-3), the same request Offhand's transcriber makes.
# Leave DEEPGRAM_API_KEY blank and the feature is inert: transcript_status stays
# null, nothing is called, nothing throws, every route behaves as it did before.
# TRANSCRIBE_PROVIDER=none turns it off explicitly even with a key present.
DEEPGRAM_API_KEY=
TRANSCRIBE_PROVIDER=deepgram
# The per-account ceiling, in seconds of audio per rolling 24 hours. Seconds
# because that is the unit Deepgram bills in. 7200 is two hours: twice the
# longest single recording the 25 MB per-file cap will accept, so no file that
# passes that cap can be refused by this one on its own, and still around 240
# half-minute memos a day. Past it POST /radio/files/:id/transcribe answers 200
# with reason:'daily_limit' -- nothing written, nothing spent -- and the ask
# works again as the window rolls forward. Set to 0 to remove the ceiling.
# The spend is measured by each note's declared duration_ms, which the client
# supplies and nothing range-checks, so a duration that is missing, zero or
# negative is charged an assumed 60s rather than taken at its word.
TRANSCRIBE_DAILY_SECONDS_PER_USER=7200

# ── Live calls (Radio) ───────────────────────────────────────────────
# Agora carries the audio and video; this server only mints the token that
# lets a phone join a channel. Both values come from one Agora project
# (console.agora.io → Project → App ID, then enable the App Certificate).
#
# The certificate is a signing key and must never reach a client binary — the
# phone asks POST /radio/calls for a token minted against a call it is
# actually on, and that token expires in an hour.
#
# Leave either blank and calling is inert: POST /radio/calls answers 503
# "Calling is not configured", and the app falls back to the toast it showed
# before calling existed. Nothing else changes.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# A locked iPhone can only be made to ring by a PushKit (VoIP) push, and
# Firebase cannot send one — there is no FCM API for VoIP — so these go
# straight to Apple. Create a key at developer.apple.com → Certificates,
# Identifiers & Profiles → Keys, with "Apple Push Notifications service
# (APNs)" enabled, and download the .p8 ONCE (Apple will not show it again).
#
#   APNS_KEY_ID       the 10-character key id from that page
#   APNS_TEAM_ID      your 10-character Apple team id
#   APNS_PRIVATE_KEY  the .p8 file's contents, newlines written as 

#   APNS_BUNDLE_ID    the app's bundle id; the VoIP topic is this + ".voip"
#   APNS_SANDBOX      true while testing with a development build
#
# Unset, calls still ring through FCM exactly as before: answerable from the
# notification, with no lock-screen ring on iOS.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_SANDBOX=false

# ── MCP connector (Claude / ChatGPT / Gemini) ─────────────────────────────────
# The public https origin this API answers on, no path, no trailing slash.
# The OAuth discovery documents advertise it verbatim, so if it is wrong the
# connector fails inside the assistant in a way that looks like their bug.
# Optional: falls back to the request's own host, which is right on Railway.
PUBLIC_BASE_URL=https://grounders-api-production.up.railway.app

# Offhand's built-in Grounders + Radio. Offhand's server presents this key to
# link a user by a phone number it has verified, and receives the same
# connector tokens the consent page issues. 32+ chars, the same value as
# GROUNDERS_PARTNER_KEY on the Offhand server: openssl rand -base64 48
# Unset, the partner endpoints answer 503 and nothing else changes.
#
# It runs in both directions now. This server also PRESENTS it, to push a kept
# ItsRadio call into Offhand as a note (OFFHAND_BASE_URL below), where it
# authorises a write: a note on an account, audio in that account's storage,
# and its recorded-time allowance spent. One secret, two doors — rotating it is
# a change in both repositories at once.
OFFHAND_PARTNER_KEY=

# Where Offhand's server lives, for pushing a kept call into it. No path, no
# trailing slash. Leave it blank and calling is unaffected except that a kept
# call is never delivered: nothing is claimed, no push status is written to the
# row at all, and the recording stays an ordinary Radio voice note. See
# CALLING.md, "Where a kept call goes".
#
# The key it sends is OFFHAND_PARTNER_KEY above. GROUNDERS_PARTNER_KEY is read
# first if it is set, because that is the name the same secret has on the
# Offhand server and in the wire contract; you do not need to set it here.
#
# It must be the origin Offhand's server actually answers on — the same value
# Offhand sets as its own PUBLIC_BASE_URL, not a prettier domain that does not
# route there yet.
OFFHAND_BASE_URL=https://offhand-api.up.railway.app

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=*
